#include<stdio.h>
#include<stdlib.h>

double calculatePower(double base, int exp){
	double result = 1.0;
	int positiveExp = exp < 0 ? -exp : exp;

	for(int i = 0; i < positiveExp; i++){
		result *= base;
	}
	if (exp < 0){
		return 1.0 / result;
	}
	return result;
}

int findGCD(int a, int b){
	a = abs(a);
	b = abs(b);
	while(b != 0){
		int rem = a % b;
		a = b;
		b = rem;
	}
	return a;
}

int main(){
	int choice;
	do{
	printf("Display a menu: 1.Power 2.GCD 3.Exit\n");
	printf("Choose an option: ");
	scanf("%d", &choice);

	switch(choice){
		case 1:
		printf("You chose Power!\n");
		double base;
		int exp;
		printf("Enter base and exponent: ");
		scanf("%lf %d", &base, &exp);
		printf("Result: %.3lf\n", calculatePower(base, exp));
		break;
		case 2:
		printf("You chose GCD!\n");
		int a, b;
		scanf("%d%d", &a, &b);
		printf("GCD of %d and %d is %d\n", a, b, findGCD(a, b));
		break;	
		case 3:
		printf("Goodbye!\n");
		break;
		default:
		printf("Invalid choice!\n");
	}


} while(choice != 3);
	return 0;
}
